maintainer="Barnabas Czeman <barnabas.czeman@postmarketos.org>"
pkgname=firmware-xiaomi-miatoll
pkgver=5
pkgrel=0
pkgdesc="Firmware for miatoll"
url="https://github.com/sm7125-mainline/firmware-xiaomi-miatoll"
arch="aarch64"
license="proprietary"
options="!strip !check !archcheck !tracedeps textrels pmb:cross-native"

_commit="a7073ad14a91a103d14effbc87a94e632e29011a"

source="
	$pkgname.tar.gz::$url/archive/$_commit/$pkgname-$_commit.tar.gz
	30-initramfs-firmware.files
	sensor.files
"

subpackages="$pkgname-sensors:firmware_sensors"
builddir="$srcdir/$pkgname-$_commit"

package() {
	echo $builddir
	_fw_path=$pkgdir/usr/lib/firmware

	install -Dm644 lib/firmware/focaltech_ts_fw_huaxing.bin -t $_fw_path
	install -Dm644 lib/firmware/novatek_ts_tianma_fw.bin -t $_fw_path
	install -Dm644 lib/firmware/qcom/sm7125/miatoll/a615_zap.mbn -t "$_fw_path"/qcom/sm7125/miatoll/
	install -Dm644 lib/firmware/qcom/sm7125/miatoll/adsp.mbn -t "$_fw_path"/qcom/sm7125/miatoll/
	install -Dm644 lib/firmware/qcom/sm7125/miatoll/cdsp.mbn -t "$_fw_path"/qcom/sm7125/miatoll/
	install -Dm644 lib/firmware/qcom/sm7125/miatoll/ipa_fws.mbn -t "$_fw_path"/qcom/sm7125/miatoll/
	install -Dm644 lib/firmware/qcom/sm7125/miatoll/modem.mbn -t "$_fw_path"/qcom/sm7125/miatoll/
	install -Dm644 lib/firmware/qcom/sm7125/miatoll/venus.mbn -t "$_fw_path"/qcom/sm7125/miatoll/
	install -Dm644 lib/firmware/qcom/sm7125/miatoll/wlanmdsp.mbn -t "$_fw_path"/qcom/sm7125/miatoll/
	install -Dm644 lib/firmware/qcom/sm7125/miatoll/adspr.jsn -t "$_fw_path"/qcom/sm7125/miatoll/
	install -Dm644 lib/firmware/qcom/sm7125/miatoll/adsps.jsn -t "$_fw_path"/qcom/sm7125/miatoll/
	install -Dm644 lib/firmware/qcom/sm7125/miatoll/adspua.jsn -t "$_fw_path"/qcom/sm7125/miatoll/
	install -Dm644 lib/firmware/qcom/sm7125/miatoll/cdspr.jsn -t "$_fw_path"/qcom/sm7125/miatoll/
	install -Dm644 lib/firmware/qcom/sm7125/miatoll/modemr.jsn -t "$_fw_path"/qcom/sm7125/miatoll/
	install -Dm644 lib/firmware/qcom/sm7125/miatoll/modemuw.jsn -t "$_fw_path"/qcom/sm7125/miatoll/

	install -Dm644 "$srcdir/30-initramfs-firmware.files" -t "$pkgdir"/usr/share/mkinitfs/files

}

firmware_sensors() {
	pkgdesc="Files to be included to add sensor support"
	depends="$pkgname=$pkgver-r$pkgrel"
	mkdir "$subpkgdir"

	while IFS="" read -r _i || [ -n "$_i" ]; do
		[ ! -d $(dirname $_i) ] && mkdir -p $(dirname $_i)
		install -Dm644 "$builddir/$_i" "$pkgdir/$_i"
	done < "$srcdir/sensor.files"
}

