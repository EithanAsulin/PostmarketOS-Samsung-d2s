# Reference: <https://postmarketos.org/devicepkg>
maintainer="SED4906 <sed4906birdie@gmail.com>"
pkgname=device-amazon-ford
pkgdesc="Amazon Fire 7 (2015)"
pkgver=6
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="armv7"
options="!check !archcheck"
depends="
	android-tools-mkbootimg
	linux-postmarketos-mediatek-mt8127
	postmarketos-base
"
makedepends="devicepkg-dev"
subpackages="$pkgname-udev"
source="
	deviceinfo
	kernel-cmdline.conf
	90-android-touch-dev.rules
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm644 "$srcdir"/90-android-touch-dev.rules \
		"$pkgdir"/usr/lib/udev/rules.d/90-android-touch-dev.rules
}

