# Reference: <https://postmarketos.org/devicepkg>
maintainer="Scott Clark <sclark100+postmarketos@gmail.com>"
pkgname=device-barnesnoble-encore
pkgdesc="Barnes & Noble Nook Color"
pkgver=5
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="armv7"
options="!check !archcheck"
depends="
	linux-postmarketos-omap
	postmarketos-base
	u-boot-tools
"
_pmb_recommends="linux-firmware-ti-connectivity"
makedepends="devicepkg-dev u-boot-tools"
subpackages="
	$pkgname-udev
	$pkgname-wayland
	$pkgname-weston
	$pkgname-x11
"
source="
	deviceinfo
	etc-profile.d-25wlr-pixman.sh
	modules-initfs
	weston.ini
	xorg-rotate-monitor.conf
	90-device-barnesnoble-encore-touchscreen.rules
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir"/90-device-barnesnoble-encore-touchscreen.rules \
		-t "$pkgdir"/usr/lib/udev/rules.d/

	# Wayland/ wlroots/ phosh:
	install -Dm644 "$srcdir"/etc-profile.d-25wlr-pixman.sh \
		-t "$pkgdir"/etc/profile.d/25wlr-pixman.sh

	# Weston:
	install -Dm644 "$srcdir"/weston.ini \
		-t "$pkgdir"/etc/xdg/weston/

	# X11:
	install -Dm644 "$srcdir"/xorg-rotate-monitor.conf \
		"$pkgdir"/usr/share/X11/xorg.conf.d/30-rotate-monitor.conf
}

wayland() {
	# This section and file were copied from nokia-n900 to get phosh running
	# on this device with similar hardware

	# This is only useful on wlroots, but it has too many verions in Alpine
	# at the moment to come up with a sane install_if
	install_if="$pkgname=$pkgver-r$pkgrel wayland-libs-server"

	amove etc/profile.d/25wlr-pixman.sh
}

weston() {
	install_if="$pkgname=$pkgver-r$pkgrel postmarketos-ui-weston"

	amove etc/xdg/weston/weston.ini
}

x11() {
	install_if="$pkgname=$pkgver-r$pkgrel xorg-server"

	amove usr/share/X11/xorg.conf.d/30-rotate-monitor.conf
}

