maintainer="Thomas Turner <tturner@lineageos.org>"
pkgname=firmware-samsung-a21s
pkgver=1
pkgrel=0
pkgdesc="Firmware for a21s"
url="https://github.com/samsungexynos850/firmware-samsung-a21s"
arch="aarch64"
license="proprietary"
options="!check !strip !archcheck !tracedeps
	pmb:cross-native
"
source="
	https://raw.githubusercontent.com/samsungexynos850/firmware-samsung-a21s/refs/heads/master/td4150_a21s.bin
	30-initramfs-firmware-samsung-a21s.files
"

package() {
	mkdir -p "$pkgdir"/usr/lib/firmware
	mv "$srcdir"/td4150_a21s.bin "$pkgdir"/usr/lib/firmware/

	install -Dm644 "$srcdir"/30-initramfs-$pkgname.files -t \
		"$pkgdir"/usr/share/mkinitfs/files
}

