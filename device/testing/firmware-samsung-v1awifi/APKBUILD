source="
	30-touchscreen-firmware.files
	BCM4354.samsung_v1a-wifi.hcd::https://github.com/exynos5420/android_vendor_samsung_universal5420-common/raw/$_universal_commit/proprietary/vendor/firmware/bcm4350_V0301.0609.hcd
	brcmfmac4354-sdio.samsung_v1a-wifi.txt::https://github.com/exynos5420/android_vendor_samsung_v1a-common/raw/$_v1a_commit/proprietary/etc/wifi/nvram_net.txt_4354_a0
	maxtouch_v1.cfg::https://gitlab.com/Eisenbahnfan/exynos5-firmware/-/raw/$_cfg_commit/mXT1664S_v.cfg
"
builddir="$srcdir"

package() {
	# Bluetooth
	install -Dm644 BCM4354.samsung_v1a-wifi.hcd \
		"$pkgdir"/usr/lib/firmware/postmarketos/brcm/BCM4354.samsung,v1a-wifi.hcd

	# Wifi
	install -Dm644 brcmfmac4354-sdio.samsung_v1a-wifi.txt \
		"$pkgdir"/usr/lib/firmware/postmarketos/brcm/brcmfmac4354-sdio.samsung,v1a-wifi.txt

	# Touchscreen
	install -Dm644 maxtouch_v1.cfg \
		"$pkgdir"/usr/lib/firmware/postmarketos/maxtouch.cfg
	install -Dm644 30-touchscreen-firmware.files \
		-t "$pkgdir"/usr/share/mkinitfs/files/
}

