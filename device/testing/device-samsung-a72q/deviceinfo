deviceinfo_name="Samsung Galaxy A72"
deviceinfo_manufacturer="Samsung"
deviceinfo_codename="samsung-a72q"
deviceinfo_year="2021"
deviceinfo_arch="aarch64"

# Device related
deviceinfo_drm="true"
deviceinfo_chassis="handset"
deviceinfo_external_storage="true"

# Bootloader related
