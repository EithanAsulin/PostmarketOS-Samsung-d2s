aa3b9fa316d9ad174b7608053cdab753a585bfe859e159442d7f9aefec6025e46ea4e3fd382f88ac46eef2436aa79927fd889530d2403a302d81e34c6e0a93b1  config-postmarketos-mediatek-mt8127.armv7
"
