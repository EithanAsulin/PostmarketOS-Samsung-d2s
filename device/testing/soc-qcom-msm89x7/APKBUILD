maintainer="Barnabas Czeman <barnabas.czeman@postmarketos.org>"
pkgname=soc-qcom-msm89x7
pkgdesc="Common package for Qualcomm MSM89x7 devices"
pkgver=11
pkgrel=0
url="https://postmarketos.org"
license="BSD-3-Clause"
arch="aarch64"
options="!check !archcheck !tracedeps pmb:cross-native"
depends="
	$pkgname-gpu
	$pkgname-modem
	$pkgname-ucm
	swclock-offset
"
install="$pkgname-modem-openrc.post-install $pkgname-modem-openrc.post-upgrade"
subpackages="
	$pkgname-gpu
	$pkgname-modem
	$pkgname-modem-openrc:modem_openrc
	$pkgname-ucm
	$pkgname-adreno-a3xx-quirks:a3xx_quirks
"

_ucm_commit="6078de44affd1023c1ba4f71ef1e21468e3282e9"
source="
	$pkgname-$_ucm_commit.tar.gz::https://github.com/msm89x7-mainline/alsa-ucm-conf/archive/$_ucm_commit.tar.gz
	adreno-quirks.sh
	a3xx-quirks.sh
	51-qcom.conf
	q6voiced.conf
"

package() {
	mkdir -p $pkgdir
	install -Dm644 "$srcdir"/51-qcom.conf \
		-t "$pkgdir"/usr/share/wireplumber/wireplumber.conf.d
	install -Dm644 "$srcdir"/a3xx-quirks.sh \
		"$pkgdir"/etc/profile.d/a3xx-quirks.sh
}

ucm() {
	provides="alsa-ucm-conf=0.$pkgver-r$pkgrel" # versioned provides need to be below default version

	cd "$srcdir/alsa-ucm-conf-$_ucm_commit"
	mkdir -p "$subpkgdir"/usr/share/alsa
	cp -r ucm2 "$subpkgdir"/usr/share/alsa
}

gpu() {
	pkgdesc="Various GPU workarounds for Adreno 308 and 505"
	install_if="$pkgname=$pkgver-r$pkgrel mesa-dri-gallium"

	install -Dm644 "$srcdir"/adreno-quirks.sh \
		"$subpkgdir"/etc/profile.d/adreno-quirks.sh
}

modem() {
	depends="
		msm-modem-wwan-port
		soc-qcom-modem
	"
	replaces="q6voiced" # installing custom config

	install -Dm644 "$srcdir"/q6voiced.conf \
		-t "$subpkgdir"/usr/share/q6voiced/
}

modem_openrc() {
	install_if="$pkgname-modem=$pkgver-r$pkgrel openrc"
	depends="
		msm-modem-wwan-port-openrc
		openrc
		soc-qcom-modem-openrc
	"
	mkdir -p "$subpkgdir"
}

a3xx_quirks() {
	pkgdesc="Various GPU workarounds for Adreno 308"
	amove etc/profile.d/a3xx-quirks.sh
}

