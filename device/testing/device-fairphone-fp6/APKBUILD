# Reference: <https://postmarketos.org/devicepkg>
maintainer="Luca Weiss <luca@lucaweiss.eu>"
pkgname=device-fairphone-fp6
pkgdesc="The Fairphone (Gen. 6)"
pkgver=8
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	firmware-fairphone-fp6-adreno
	firmware-fairphone-fp6-adsp
	firmware-fairphone-fp6-bluetooth
	firmware-fairphone-fp6-cdsp
	firmware-fairphone-fp6-ipa
	firmware-fairphone-fp6-modem
	firmware-fairphone-fp6-vpu
	firmware-fairphone-fp6-wpss
	linux-firmware-ath11k
	linux-postmarketos-qcom-milos
	make-dynpart-mappings
	mkbootimg
	postmarketos-base
	soc-qcom
	soc-qcom-modem
	soc-qcom-qbootctl
	systemd-boot
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	drm-backend.conf
	initfs-unl0kr.files
	kernel-cmdline.conf
	modules-initfs
	sim-wait-time.conf
	"
subpackages="$pkgname-f0rmz $pkgname-systemd $pkgname-unl0kr"
build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir"/sim-wait-time.conf \
		"$pkgdir"/usr/lib/systemd/system/msm-modem-uim-selection.service.d/sim-wait-time.conf
	install -Dm644 "$srcdir"/drm-backend.conf \
		-t "$pkgdir"/usr/share/f0rmz/f0rmz.conf.d
	install -Dm644 "$srcdir"/drm-backend.conf \
		-t "$pkgdir"/usr/share/unl0kr/unl0kr.conf.d
	install -Dm644 "$srcdir"/initfs-unl0kr.files \
		"$pkgdir"/usr/share/mkinitfs/files-extra/"$pkgname"-unl0kr.files
}

f0rmz() {
	install_if="$pkgname=$pkgver-r$pkgrel f0rmz"
	amove usr/share/f0rmz/f0rmz.conf.d/drm-backend.conf
}

unl0kr() {
	install_if="$pkgname=$pkgver-r$pkgrel unl0kr"
	amove usr/share/mkinitfs/files-extra/"$pkgname"-unl0kr.files
	amove usr/share/unl0kr/unl0kr.conf.d/drm-backend.conf
}

