b5db13c7e9804b29a34bbff2bcfc534751b30b500a5c3b95f5bddfe42de2a48fb3d05b5ddcd68159845d828447b44125acb136476596ec8c3e982536a5834ae0  config-postmarketos-mediatek-mt6763.aarch64
"
