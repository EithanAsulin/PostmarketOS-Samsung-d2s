maintainer="Erikas Bitovtas <xerikasxx@gmail.com>"
pkgname=firmware-samsung-a72q
pkgver=1
pkgrel=0
_commit="cbce286491dad00e7cbadc7ed923bb295a007d38"
pkgdesc="Firmware for a72q"
url="https://github.com/erikas9987/firmware-samsung-a72q"
arch="aarch64"
license="proprietary"
depends="linux-firmware-ath10k linux-firmware-qca linux-firmware-qcom"
source="
	$pkgname.tar.gz::https://github.com/erikas9987/firmware-samsung-a72q/archive/$_commit/firmware-samsung-a72q-$_commit.tar.gz
	30-initramfs-firmware.files
	firmware.files
"
options="
	!archcheck
	!check
	!strip
	!tracedeps
	pmb:cross-native
	textrels
"
builddir="$srcdir/$pkgname-$_commit"

package() {
	local _i _u
	while IFS="" read -r _i || [ -n "$_i" ]; do
		_u="${_i/usr\/lib/\/lib}"
		install -Dm644 "$builddir"/"$_i" "$pkgdir"/"$_i"
	done < "$srcdir"/firmware.files

	install -Dm644 "$srcdir"/30-initramfs-firmware.files \
		-t "$pkgdir"/usr/share/mkinitfs/files
}

