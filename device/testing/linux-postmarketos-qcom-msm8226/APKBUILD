f5f0c2a788cffa598404ba55d46535e173b92c2055ef0019774056af09870c2530b7b83f353c7f4516eb900a29f2ed50fe9ce59305189594c5b2e91a07d2a10b  config-postmarketos-qcom-msm8226.armv7
"
