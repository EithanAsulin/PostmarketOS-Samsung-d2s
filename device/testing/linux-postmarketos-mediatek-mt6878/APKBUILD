f9833236e45fb93e4c8e98c7d86882131a14acd6d4a6570d8f3f76c413f200245a9703c0b7d8c4e9ce11f5041fdbc460635e759dba81ca960886633abcbf6a53  config-postmarketos-mediatek-mt6878.aarch64
"
