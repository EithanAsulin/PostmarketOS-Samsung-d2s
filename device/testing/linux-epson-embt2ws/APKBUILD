5dfd5cd4c60e94d8fa96345189cd7786254ae9c2a2508484279227449d0cee38612e8f5586cfa1fc13f1530aaed2bda5987cc6e96d97aad097b0f13eabac5aa7  config-epson-embt2ws.armv7
"
