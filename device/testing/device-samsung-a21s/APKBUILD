# Reference: <https://postmarketos.org/devicepkg>
maintainer="Thomas Turner <tturner@lineageos.org>"
pkgname=device-samsung-a21s
pkgver=1
pkgrel=1
pkgdesc="Samsung Galaxy A21s"
url="https://postmarketos.org"
arch="aarch64"
license="MIT"
depends="
	android-tools-avbtool
	android-tools-mkbootimg
	firmware-samsung-a21s
	linux-postmarketos-exynos850
	postmarketos-base
"
makedepends="
	android-tools-mkdtboimg
	devicepkg-dev
	dtc
"
source="
	deviceinfo
	exynos850-samsung-a21s-empty.dts
"
options="!archcheck !check"

build() {
	devicepkg_build $startdir $pkgname

	dtc -O dtb -o "$srcdir/dtbo" -I dts "$srcdir/exynos850-samsung-a21s-empty.dts"
	mkdtboimg create "$srcdir/dtbo.img" "$srcdir/dtbo" --custom0=0x6 --custom1=0x20
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir/dtbo.img" "$pkgdir/boot/dtbo.img"
}

