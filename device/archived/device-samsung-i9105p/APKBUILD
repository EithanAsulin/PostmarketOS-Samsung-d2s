# Archived: unmaintained
# Reference: <https://postmarketos.org/devicepkg>
maintainer=""
pkgname=device-samsung-i9105p
pkgdesc="Samsung Galaxy S2 Plus"
pkgver=6
pkgrel=1
url="https://postmarketos.org"
license="MIT"
arch="armv7"
options="!check !archcheck"
depends="
	firmware-samsung-i9105p
	linux-samsung-i9105p
	mkbootimg
	msm-fb-refresher
	postmarketos-base
	postmarketos-base-downstream
"

subpackages="$pkgname-x11"

makedepends="devicepkg-dev"
source="
	deviceinfo
	modules-load.conf
	10-vc-fb.conf
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
}

x11() {
	pkgdesc="Xorg config for vc_fb"
	install_if="$pkgname=$pkgver-r$pkgrel xorg-server"
	install -Dm644 "$srcdir"/10-vc-fb.conf \
		"$subpkgdir"/etc/X11/xorg.conf.d/10-vc-fb.conf
}

