# Reference: <https://postmarketos.org/devicepkg>
# Co-Maintainer: Aster Boese <asterboese@mailbox.org>
# Co-Maintainer: Matt Panhans <mpanhans@protonmail.com>
maintainer="Casey Connolly <kcxt@postmarketos.org>"
pkgname=device-oneplus-fajita
pkgver=32
pkgrel=0
pkgdesc="OnePlus 6T"
url="https://postmarketos.org"
arch="aarch64"
license="MIT"
depends="
	alsa-ucm-conf-sdm845
	firmware-oneplus-sdm845>=9
	firmware-oneplus-sdm845-sensors
	hexagonrpcd>=0.3.2-r3
	linux-postmarketos-qcom-sdm845
	mkbootimg
	postmarketos-base
	soc-qcom
	soc-qcom-modem
	soc-qcom-qbootctl
	systemd-boot
	unl0kr-fbforcerefresh
	"
depends_openrc="hexagonrpcd-openrc"
makedepends="devicepkg-dev"
install="
	$pkgname-openrc.post-install
	$pkgname-openrc.post-upgrade
	"
subpackages="
	$pkgname-openrc
	$pkgname-pmtest
	$pkgname-systemd
	$pkgname-udev
	"
source="
	80-device-oneplus-fajita.preset
	81-libssc-oneplus-fajita.rules
	deviceinfo
	hexagonrpcd-sdsp.conf
	kernel-cmdline.conf
	modules-initfs
	q6voiced.conf
	"
options="!archcheck !check"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir"/81-libssc-oneplus-fajita.rules \
		-t "$pkgdir"/usr/lib/udev/rules.d/
	install -Dm644 "$srcdir"/q6voiced.conf \
		-t "$pkgdir"/usr/share/q6voiced/
	install -Dm644 "$srcdir"/hexagonrpcd-sdsp.conf \
		-t "$pkgdir"/usr/share/hexagonrpcd/
	install -Dm644 "$srcdir"/80-device-oneplus-fajita.preset \
		-t "$pkgdir"/usr/lib/systemd/system-preset
}

openrc() {
	default_openrc
	mkdir -p "$subpkgdir"
}

pmtest() {
	depends="postmarketos-test-bootrr qrtr postmarketos-test-unl0kr"
	install_if="$pkgname=$pkgver-r$pkgrel postmarketos-mkinitfs-hook-ci"

	mkdir -p "$subpkgdir"
}

