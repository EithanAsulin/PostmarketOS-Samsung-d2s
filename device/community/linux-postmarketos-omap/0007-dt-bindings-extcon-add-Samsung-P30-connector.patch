From 8940ab1a39ecce0a159010b571cf81f8ec916ecb Mon Sep 17 00:00:00 2001
From: Nuke <retuhmadam2010@proton.me>
Date: Thu, 13 Aug 2026 18:41:51 +0400
Subject: [PATCH 07/11] dt-bindings: extcon: add Samsung P30 connector

---
 .../extcon/samsung,p30-connector.yaml         | 54 +++++++++++++++++++
 1 file changed, 54 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/extcon/samsung,p30-connector.yaml

diff --git a/Documentation/devicetree/bindings/extcon/samsung,p30-connector.yaml b/Documentation/devicetree/bindings/extcon/samsung,p30-connector.yaml
new file mode 100644
index 000000000..371bccb1b
--- /dev/null
+++ b/Documentation/devicetree/bindings/extcon/samsung,p30-connector.yaml
@@ -0,0 +1,54 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/extcon/samsung,p30-connector.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung 30-pin accessory connector
+
+maintainers:
+  - Nuke <retuhmadam2010@proton.me>
+
+description: |
+  The Samsung 30-pin accessory connector used on Galaxy Tab tablets
+  identifies accessories through an analog ACCESSORY_ID signal measured
+  by an external ADC. A separate GPIO indicates attachment and removal.
+
+  USB OTG adapters are reported through the extcon subsystem as USB host
+  connections.
+
+properties:
+  compatible:
+    const: samsung,p30-connector
+
+  detect-gpios:
+    maxItems: 1
+    description:
+      GPIO indicating whether an accessory is attached.
+
+  io-channels:
+    maxItems: 1
+    description:
+      ADC channel used to measure the ACCESSORY_ID signal.
+
+  io-channel-names:
+    const: accessory-id
+
+required:
+  - compatible
+  - detect-gpios
+  - io-channels
+  - io-channel-names
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    connector {
+        compatible = "samsung,p30-connector";
+        detect-gpios = <&gpio1 31 GPIO_ACTIVE_LOW>;
+        io-channels = <&adc 3>;
+        io-channel-names = "accessory-id";
+    };
-- 
