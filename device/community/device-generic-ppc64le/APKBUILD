# Reference: <https://postmarketos.org/devicepkg>
# Co-Maintainer: Achill Gilgenast <achill@achill.org>
# Co-Maintainer: famfo <famfo@famfo.xyz>
maintainer="Aelin <aelin@postmarketos.org>"
pkgname=device-generic-ppc64le
pkgver=2
pkgrel=0
pkgdesc="Generic ppc64le system"
url="https://postmarketos.org"
arch="ppc64le"
license="MIT"
depends="
	postmarketos-base
	powervm-boot
	"
makedepends="devicepkg-dev"
subpackages="
	$pkgname-kernel-stable:kernel_stable
	$pkgname-kernel-lts:kernel_lts
	$pkgname-kernel-mainline:kernel_mainline
	"

source="
	deviceinfo
	grub.cfg
	kernel-cmdline.conf
	modules-initfs
	"
options="!check !archcheck"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# Install a stub GRUB configuration that declares that we're using BLS.1
	# This is processed by Petitboot
	install -Dm644 grub.cfg "$pkgdir"/boot/grub2/grub.cfg
}

kernel_stable() {
	pkgdesc="Stable kernel (recommended, best balance between stability and features)"
	depends="linux-postmarketos-stable linux-firmware-none"
	devicepkg_subpackage_kernel $startdir $pkgname $subpkgname
}

kernel_lts() {
	pkgdesc="Long-term maintenance kernel (most stability, not all security fixes & new features)"
	depends="linux-postmarketos-lts linux-firmware-none"
	devicepkg_subpackage_kernel $startdir $pkgname $subpkgname
}

kernel_mainline() {
	pkgdesc="Upstream development kernel (regular breakage, latest features)"
	depends="linux-postmarketos-mainline linux-firmware-none"
	devicepkg_subpackage_kernel $startdir $pkgname $subpkgname
}

