From: Ondrej Jirman <megi@xff.cz>
Date: Tue, 20 Feb 2024 18:31:33 +0100
Subject: [PATCH 48/90] arm64: dts: rockchip: rk3399-pinephone-pro: Change
 modem codec samplerate to 16kHz

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 arch/arm64/boot/dts/rockchip/rk3399-pinephone-pro.dts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/rockchip/rk3399-pinephone-pro.dts b/arch/arm64/boot/dts/rockchip/rk3399-pinephone-pro.dts
index 07dfaa31c361..7eed48fa1a7e 100644
--- a/arch/arm64/boot/dts/rockchip/rk3399-pinephone-pro.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3399-pinephone-pro.dts
@@ -1084,7 +1084,7 @@ modem {
 		cts-gpios = <&gpio3 RK_PC0 GPIO_ACTIVE_HIGH>;
 		rts-gpios = <&gpio3 RK_PC1 GPIO_ACTIVE_HIGH>;
 
-		quectel,qdai = "3,0,0,4,0,0,1,1";
+		quectel,qdai = "3,0,0,4,0,1,1,1";
 	};
 };
 
