From 2ef8e0cf61ae74aa2984a9b0c811b66e4d88a0e2 Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Mon, 20 Jul 2026 17:48:45 +0200
Subject: [PATCH 70/90] usb: dwc3: Track cable connection state separately from
 dr_role

A Type-C port can be unplugged and replugged into the same kind of port
without the DRD role ever changing. __dwc3_set_mode() bails out early
when the desired role equals the current one, so such a transition is
invisible to the driver, even though it may need to act on it.

Track connectedness in its own pair of flags rather than encoding it in
current_dr_role. current_dr_role holds a GCTL.PrtCapDir register value
and is compared against DWC3_GCTL_PRTCAP_* throughout the driver, in the
glue drivers, in debugfs and in tracing, so giving it an out-of-range
value would mean auditing every one of those users.

dwc3_set_mode() keeps its meaning and implies "connected", so existing
callers are unaffected. Only callers that can actually distinguish a
cable from no cable use dwc3_set_mode_connected().

No functional change.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 drivers/usb/dwc3/core.c | 20 ++++++++++++++++++--
 drivers/usb/dwc3/core.h |  9 +++++++++
 2 files changed, 27 insertions(+), 2 deletions(-)

diff --git a/drivers/usb/dwc3/core.c b/drivers/usb/dwc3/core.c
index cf12ab17ccb4..3d2ea52d9648 100644
--- a/drivers/usb/dwc3/core.c
+++ b/drivers/usb/dwc3/core.c
@@ -169,11 +169,13 @@ static void __dwc3_set_mode(struct work_struct *work)
 	int ret;
 	u32 reg;
 	u32 desired_dr_role;
+	bool desired_dr_connected;
 	int i;
 
 	mutex_lock(&dwc->mutex);
 	spin_lock_irqsave(&dwc->lock, flags);
 	desired_dr_role = dwc->desired_dr_role;
+	desired_dr_connected = dwc->desired_dr_connected;
 	spin_unlock_irqrestore(&dwc->lock, flags);
 
 	pm_runtime_get_sync(dwc->dev);
@@ -184,7 +186,8 @@ static void __dwc3_set_mode(struct work_struct *work)
 	if (!desired_dr_role)
 		goto out;
 
-	if (desired_dr_role == dwc->current_dr_role)
+	if (desired_dr_role == dwc->current_dr_role &&
+	    desired_dr_connected == dwc->current_dr_connected)
 		goto out;
 
 	if (desired_dr_role == DWC3_GCTL_PRTCAP_OTG && dwc->edev)
@@ -244,6 +247,7 @@ static void __dwc3_set_mode(struct work_struct *work)
 	 */
 	dwc3_enable_susphy(dwc, false);
 	dwc3_set_prtcap(dwc, desired_dr_role, true);
+	dwc->current_dr_connected = desired_dr_connected;
 
 	spin_unlock_irqrestore(&dwc->lock, flags);
 
@@ -295,7 +299,7 @@ static void __dwc3_set_mode(struct work_struct *work)
 	mutex_unlock(&dwc->mutex);
 }
 
-void dwc3_set_mode(struct dwc3 *dwc, u32 mode)
+void dwc3_set_mode_connected(struct dwc3 *dwc, u32 mode, bool connected)
 {
 	unsigned long flags;
 
@@ -304,11 +308,17 @@ void dwc3_set_mode(struct dwc3 *dwc, u32 mode)
 
 	spin_lock_irqsave(&dwc->lock, flags);
 	dwc->desired_dr_role = mode;
+	dwc->desired_dr_connected = connected;
 	spin_unlock_irqrestore(&dwc->lock, flags);
 
 	queue_work(system_freezable_wq, &dwc->drd_work);
 }
 
+void dwc3_set_mode(struct dwc3 *dwc, u32 mode)
+{
+	dwc3_set_mode_connected(dwc, mode, true);
+}
+
 u32 dwc3_core_fifo_space(struct dwc3_ep *dep, u8 type)
 {
 	struct dwc3		*dwc = dep->dwc;
@@ -1665,6 +1675,12 @@ static int dwc3_core_init_mode(struct dwc3 *dwc)
 		break;
 	case USB_DR_MODE_OTG:
 		INIT_WORK(&dwc->drd_work, __dwc3_set_mode);
+		/*
+		 * Default to "connected", which is what dwc3_set_mode() implies.
+		 * Only users that can actually tell a cable apart from no cable
+		 * ever clear this, via dwc3_set_mode_connected().
+		 */
+		dwc->current_dr_connected = true;
 		ret = dwc3_drd_init(dwc);
 		if (ret)
 			return dev_err_probe(dev, ret, "failed to initialize dual-role\n");
diff --git a/drivers/usb/dwc3/core.h b/drivers/usb/dwc3/core.h
index 19a93c3dd668..03fd08d0dca1 100644
--- a/drivers/usb/dwc3/core.h
+++ b/drivers/usb/dwc3/core.h
@@ -1050,6 +1050,12 @@ struct dwc3_glue_ops {
  * @dr_mode: requested mode of operation
  * @current_dr_role: current role of operation when in dual-role mode
  * @desired_dr_role: desired role of operation when in dual-role mode
+ * @current_dr_connected: set if a cable is currently known to be connected
+ * @desired_dr_connected: set if a cable is desired to be considered connected.
+ *			  Tracked separately from @desired_dr_role because the
+ *			  role does not change when a cable is unplugged from
+ *			  and replugged into the same kind of port, yet the
+ *			  transition still has to be acted upon.
  * @edev: extcon handle
  * @edev_nb: extcon notifier
  * @hsphy_mode: UTMI phy mode, one of following:
@@ -1250,6 +1256,8 @@ struct dwc3 {
 	enum usb_dr_mode	dr_mode;
 	u32			current_dr_role;
 	u32			desired_dr_role;
+	bool			current_dr_connected;
+	bool			desired_dr_connected;
 	struct extcon_dev	*edev;
 	struct notifier_block	edev_nb;
 	enum usb_phy_interface	hsphy_mode;
@@ -1596,6 +1604,7 @@ struct dwc3_gadget_ep_cmd_params {
 /* prototypes */
 void dwc3_set_prtcap(struct dwc3 *dwc, u32 mode, bool ignore_susphy);
 void dwc3_set_mode(struct dwc3 *dwc, u32 mode);
+void dwc3_set_mode_connected(struct dwc3 *dwc, u32 mode, bool connected);
 u32 dwc3_core_fifo_space(struct dwc3_ep *dep, u8 type);
 
 #define DWC3_IP_IS(_ip)							\
-- 
2.55.0

