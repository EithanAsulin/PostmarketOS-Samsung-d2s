From f20d0a69b2d03cd75a7be7c2b79da1d11a72556d Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Thu, 29 Jun 2023 16:28:08 +0200
Subject: [PATCH 57/90] arm64: dts: rockchip: rk3399-pinephone-pro: Improve SPI
 access speed

From 300 KiB/s to 2MiB/s.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 arch/arm64/boot/dts/rockchip/rk3399-pinephone-pro.dts | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/rockchip/rk3399-pinephone-pro.dts b/arch/arm64/boot/dts/rockchip/rk3399-pinephone-pro.dts
index 41eede2b7c60..ece5473efcd6 100644
--- a/arch/arm64/boot/dts/rockchip/rk3399-pinephone-pro.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3399-pinephone-pro.dts
@@ -1513,11 +1513,14 @@ &sdhci {
 
 &spi1 {
 	status = "okay";
+	assigned-clocks = <&cru SCLK_SPI1>;
+	assigned-clock-rates = <100000000>;
 
 	flash@0 {
 		compatible = "jedec,spi-nor";
 		reg = <0>;
-		spi-max-frequency = <10000000>;
+		m25p,fast-read;
+		spi-max-frequency = <50000000>;
 		vcc-supply = <&vcc_1v8>;
 	};
 };
-- 
2.55.0

