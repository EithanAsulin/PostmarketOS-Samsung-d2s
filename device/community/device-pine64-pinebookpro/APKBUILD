# Reference: <https://postmarketos.org/devicepkg>
# Co-Maintainer: Alexey Minnekhanov <alexeymin@postmarketos.org>
maintainer="Hugo Osvaldo Barrera <hugo@whynothugo.nl>"
pkgname=device-pine64-pinebookpro
pkgdesc="PINE64 Pinebook Pro"
pkgver=24
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	alsa-ucm-conf>=1.2.7
	iw
	linux-firmware-brcm
	linux-firmware-rockchip
	linux-postmarketos-rockchip>=5.14
	nvme-cli
	postmarketos-base>=25-r1
	soc-rockchip-rk3399
	u-boot-pinebookpro
	"
makedepends="devicepkg-dev"
install="
	$pkgname-elogind.post-install
	$pkgname-elogind.post-upgrade
	$pkgname-openrc.post-install
	$pkgname-openrc.post-upgrade
	"
subpackages="
	$pkgname-elogind
	$pkgname-openrc
	"
replaces="device-pine64-pinebookpro-nonfree-firmware"
source="
	deviceinfo
	kernel-cmdline.conf
	modules-initfs
	nvme-powersave.initd
	wlan-powersave-off.initd
	enable-s2idle.conf
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -D -m755 "$srcdir"/nvme-powersave.initd \
		"$pkgdir"/etc/init.d/nvme-powersave

	install -D -m755 "$srcdir"/wlan-powersave-off.initd \
		"$pkgdir"/etc/init.d/wlan-powersave-off

	# Workaround for kernel load brcm43455 firmware bug
	# details: https://gitlab.postmarketos.org/postmarketOS/pmaports/-/issues/4285
	mkdir -p "$pkgdir"/usr/lib/firmware/brcm
	ln -s brcmfmac43455-sdio.AW-CM256SM.txt.zst \
		"$pkgdir"/usr/lib/firmware/brcm/brcmfmac43456-sdio.pine64,pinebook-pro.txt.zst
}

elogind() {
	install_if="$pkgname=$pkgver-r$pkgrel elogind"
	install -D -m644 "$srcdir"/enable-s2idle.conf \
		"$subpkgdir"/usr/lib/elogind/sleep.conf.d/enable-s2idle.conf
}

openrc() {
	default_openrc
	depends="eudev-hwids openrc"
}

