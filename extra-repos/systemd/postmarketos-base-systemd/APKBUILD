# pmbootstrap installs this, if systemd is selected in "pmbootstrap init".
maintainer="Clayton Craft <clayton@craftyguy.net>"
pkgname=postmarketos-base-systemd
pkgver=92
pkgrel=0
pkgdesc="Meta package for running postmarketOS with systemd"
url="https://postmarketos.org"
# armhf: pmb#2618
arch="noarch !armhf"
license="GPL-3.0-or-later"
triggers="$pkgname.trigger=/usr/lib/systemd/system:/usr/lib/systemd/user"

# systemd <-> util-linux is an expected cycial dependency
# Also we can't parse .note.dlopen yet.
#
# Optional dependencies by systemd, but needed on an actual system:
# less
# login-utils
# so:libkmod.so.2
#
# linux-pam:
# - pam_systemd.so is added since 1.7.0-r1
# - pam_limits.so isn't used in alpine/pmOS, so it isn't supported and tested.
#   Additionally pam_limits.so can be compiled with (e)logind support, which
#   isn't currently done in aports. In the unlikely case this is changed
#   upstream and elogind-libs are used.
depends="
	dbus-broker
	kbd
	kmod
	less
	linux-pam>=1.7.0-r1
	login-utils
	polkit>9990
	rtkit
	so:libkmod.so.2
	systemd
	systemd-resolved
	systemd-services
	systemd-timesyncd
	treescan
	tzdata
	"
checkdepends="postmarketos-testlib"
provides="postmarketos-base-init"
provider_priority=100
replaces="alpine-baselayout openssh-server-pam postmarketos-baselayout postmarketos-base systemd systemd-logind"
replaces_priority=100
install="
	$pkgname.post-install
	$pkgname.post-upgrade
	$pkgname.pre-upgrade
	"
subpackages="
	$pkgname-resolved
	$pkgname-unudhcpd
	postmarketos-base-apk-systemd:_apk
	"

_source644="
	etc/pam.d/sshd
	etc/profile.d/20locale.sh
	usr/lib/NetworkManager/conf.d/50-dns.conf
	usr/lib/systemd/journald.conf.d/10-postmarketos.conf
	usr/lib/systemd/logind.conf
	usr/lib/systemd/resolved.conf.d/10-disable-dnsovertls.conf
	usr/lib/systemd/resolved.conf.d/10-disable-mdns.conf
	usr/lib/systemd/system-preset/90-base.preset
	usr/lib/systemd/system/-.slice.d/10-oomd-defaults.conf
	usr/lib/systemd/system/apk-inhibit.path
	usr/lib/systemd/system/apk-inhibit.service
	usr/lib/systemd/system/resolv-conf-stub-link.service
	usr/lib/systemd/system/system.slice.d/10-oomd-defaults.conf
	usr/lib/systemd/system/tmp.mount.d/10-min-memory.conf
	usr/lib/systemd/system/unudhcpd@usb0.service.d/udc-only.conf
	usr/lib/systemd/system/user@.service.d/10-oomd-defaults.conf
	usr/lib/systemd/user-preset/90-base.preset
	usr/lib/systemd/user/app.slice.d/10-oomd-defaults.conf
	usr/share/mkinitfs/files-extra/01-initramfs-base-systemd.files
"

_source755="
	etc/apk/commit_hooks.d/postmarketos-base-systemd
	usr/bin/resolv-conf-stub-link
	usr/bin/setup-timezone
	usr/libexec/apk-inhibit
	usr/libexec/systemd-apk-trigger
"

flatpath() {
	local i
	for i in $@; do
		echo "rootfs-$i" | sed s./.-.g
	done
}
source="
	$(flatpath $_source644 $_source755)
	tests/01-remove-unit-symlinks-testlib.sh
	tests/02-parse-diff-output-testlib.sh
	tests/03-trigger-systemd-presets-testlib.sh
	"

check() {
	postmarketos-testlib "$srcdir"
}

package() {
	local i
	for i in $_source644; do
		install -Dm644 "$srcdir/$(flatpath "$i")" "$pkgdir/$i"
	done
	for i in $_source755; do
		install -Dm755 "$srcdir/$(flatpath "$i")" "$pkgdir/$i"
	done

	# Setup VT template generation:
	# Distros must create this symlink manually. See
	# https://www.freedesktop.org/software/systemd/man/latest/logind.conf.html#NAutoVTs=
	# https://github.com/systemd/systemd/commit/072e72424b2e6da1c96489ef6996f49fabd46474
	ln -s getty@.service \
		"$pkgdir"/usr/lib/systemd/system/autovt@.service
}

resolved() {
	install_if="$pkgname=$pkgver-r$pkgrel systemd-resolved"

	amove usr/bin/resolv-conf-stub-link
	amove usr/lib/NetworkManager/conf.d/50-dns.conf
	amove usr/lib/systemd/resolved.conf.d/10-disable-dnsovertls.conf
	amove usr/lib/systemd/resolved.conf.d/10-disable-mdns.conf
	amove usr/lib/systemd/system/resolv-conf-stub-link.service
}

_apk() {
	install_if="$pkgname=$pkgver-r$pkgrel apk-tools"
	depends="inotify-tools flock"

	amove usr/libexec/apk-inhibit
	amove usr/lib/systemd/system/apk-inhibit.path
	amove usr/lib/systemd/system/apk-inhibit.service
}

unudhcpd() {
	install_if="$pkgname=$pkgver-r$pkgrel unudhcpd"

	amove  usr/lib/systemd/system/unudhcpd@usb0.service.d/udc-only.conf
}

