maintainer="Ferass El Hafidi <funderscore@postmarketos.org>"
pkgname=amlogic-fiptool
pkgver=2015.01
pkgrel=1
pkgdesc="Amlogic FIP utility for S905, extracted from downstream U-Boot sources"
url="https://postmarketos.org"
arch="all"
license="BSD-3-Clause"
makedepends="$depends_dev
	bsd-compat-headers
	swig
"
source="u-boot-odroidc2-v2015.01.tar.gz::https://github.com/hardkernel/u-boot/archive/refs/heads/odroidc2-v2015.01.tar.gz
	remove-wall.patch
	"
options="!check"
builddir="$srcdir/u-boot-odroidc2-v2015.01"

build() {
	make fip_create
}

package() {
	mkdir -p "$pkgdir"/usr/bin
	install -Dm755 -t "$pkgdir"/usr/bin \
		"$builddir"/tools/fip_create/fip_create
}

