# Co-Maintainer: Anjandev Momi <anjan@momi.ca>
# Co-Maintainer: Maarten van Gompel <proycon@anaproy.nl>
# Co-Maintainer: Aren Moynihan <aren@peacerevolution.org>
maintainer="Willow Barraco <contact@willowbarraco.fr>"
pkgname=postmarketos-ui-sxmo-de-dwm
pkgver=1.18.0 # Bump this so the file names in bpo are correct
pkgrel=2
pkgdesc="Simple Mobile: Mobile environment based on SXMO and running on dwm"
url="http://sr.ht/~mil/Sxmo"
arch="noarch"
license="AGPL-3.0-only"
depends="
	postmarketos-base-ui
	postmarketos-base-ui-audio
	postmarketos-base-ui-networkmanager
	sxmo-utils-audio-bluetooth
	sxmo-utils-dwm
	sxmo-utils-modem
	sxmo-utils-modem-mms
	sxmo-utils-modem-vvm
	"
install="
	$pkgname.post-install
	$pkgname.post-upgrade
	$pkgname-openrc.post-install
	$pkgname-openrc.post-upgrade
	"
_pmb_groups="input"
_pmb_recommends="
	w3m
	sfeed

	adwaita-icon-theme
	clickclack
	postmarketos-artwork-wallpapers
	ttyescape
	xcalc
	"
provides="postmarketos-ui-sxmo"
provider_priority=5
options="!check pmb:default-openrc pmb:support-openrc pmb:support-systemd"
subpackages="$pkgname-openrc"

package() {
	mkdir -p "$pkgdir"
}

openrc() {
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	depends="
		openrc
		tinydm-openrc
		modemmanager-openrc
		networkmanager-openrc
		bluez-openrc
		iio-sensor-proxy-openrc
		"

	mkdir -p "$subpkgdir"
}
